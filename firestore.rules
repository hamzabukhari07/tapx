rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidQrCodeLink(data) {
      return data.keys().hasAll(['destinationUrl', 'businessName', 'userId', 'createdAt', 'updatedAt']) 
        && data.keys().size() == 5
        && data.destinationUrl is string && data.destinationUrl.size() <= 2048
        && data.businessName is string && data.businessName.size() <= 200
        && data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /qr_links/{linkId} {
      allow get: if isValidId(linkId);
      
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && isValidId(linkId)
        && isValidQrCodeLink(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
        
      allow update: if isSignedIn() 
        && isValidId(linkId)
        && existing().userId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['destinationUrl', 'businessName', 'updatedAt'])
        && incoming().destinationUrl is string && incoming().destinationUrl.size() <= 2048
        && incoming().businessName is string && incoming().businessName.size() <= 200
        && incoming().updatedAt == request.time;
        
      allow delete: if isSignedIn() 
        && isValidId(linkId)
        && existing().userId == request.auth.uid;
    }
  }
}
