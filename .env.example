# Supabase (server-side only - used by api/ functions and local dev server)
# Get these from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Admin login credentials (server-side only)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY: Required for Google Maps Places Search and Link Extraction
GOOGLE_MAPS_API_KEY=""
