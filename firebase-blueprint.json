{
  "entities": {
    "QrCodeLink": {
      "title": "QR Code Link",
      "description": "A dynamic link mapping a generic ID to a specific Google Review URL",
      "type": "object",
      "properties": {
        "destinationUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "businessName": {
          "type": "string",
          "maxLength": 200
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "timestamp"
        },
        "updatedAt": {
          "type": "timestamp"
        }
      },
      "required": ["destinationUrl", "businessName", "userId", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "qr_links/{linkId}": {
      "schema": {
        "$ref": "#/entities/QrCodeLink"
      },
      "description": "Stores the dynamic QR code mappings"
    }
  }
}
